#!/usr/bin/env sh
# collar post-commit — 仅在 BREAKING 或大架构变动时做轻量提示（不打扰日常 Minor 提交）

set -u
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$ROOT" || exit 0

MSG=$(git log -1 --pretty=%s 2>/dev/null || true)
case "$MSG" in
  *"!:"*|*BREAKING*)
    echo
    echo "post-commit: 检测到 BREAKING 变更 —— 建议在 CHANGELOG.md / docs/changelog/ 记录迁移方式"
    ;;
esac
exit 0
