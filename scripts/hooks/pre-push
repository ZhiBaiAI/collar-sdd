#!/usr/bin/env sh
# collar pre-push — 推送前复跑结构门禁，并提醒 Standard/Major 改动完成语义确认

set -u
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$ROOT" || exit 1

sh scripts/collar-check.sh || exit 1

echo
echo "pre-push 轻量自查（Minor 小改可忽略；Standard/Major 改动请确认）："
echo "  · 代码与 Spec 有偏离时已输出差异清单并确认（不自动反向改 Spec）"
echo "  · 涉及外置逻辑（配置/提示词/脚本平台）的已缝补（MCP / //! 锚点 / ADR）"
echo "  · 发版或架构大改已跑 release 档全量验证"
exit 0
